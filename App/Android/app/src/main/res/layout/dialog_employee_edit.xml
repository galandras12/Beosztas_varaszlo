<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <EditText
            android:id="@+id/etEmpName"
            style="@style/Widget.Glass.EditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Név" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Munkacsoport"
            android:textColor="@color/text_muted"
            android:textSize="12sp" />

        <Spinner
            android:id="@+id/spGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <EditText
            android:id="@+id/etFactor"
            style="@style/Widget.Glass.EditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:hint="Munkaidő-arány (1 = teljes, 0.5 = fél)"
            android:inputType="numberDecimal" />

        <EditText
            android:id="@+id/etMaxVacation"
            style="@style/Widget.Glass.EditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:hint="Max. kiadható szabadság (nap/év) — kötelező"
            android:inputType="number" />

        <EditText
            android:id="@+id/etNotes"
            style="@style/Widget.Glass.EditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:hint="Megjegyzés"
            android:minLines="2"
            android:gravity="top" />

        <LinearLayout
            android:id="@+id/excludedShiftsWrap"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="12dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Nem osztható be automatikusan (kérésre) az alábbi műszaktípusokba:"
                android:textColor="@color/text_muted"
                android:textSize="12sp" />

            <LinearLayout
                android:id="@+id/excludedShiftsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
