<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- ===================== Google Material 3 kártya ===================== -->
    <!-- A régebbi "Widget.Glass.*" stílusneveket szándékosan megtartottuk (ezekre
         hivatkozik minden layout/dialog fájl), de a tartalmuk mostantól valódi,
         sík (nem áttetsző) Material 3 megjelenést ad: M3 kártya-alapstílus,
         kerekített (12dp, M3 "medium" shape), finom kontúr, kis emelkedés. -->
    <style name="Widget.Glass.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">@color/surface</item>
        <item name="cardCornerRadius">12dp</item>
        <item name="cardElevation">1dp</item>
        <item name="strokeColor">@color/border</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <!-- ===================== Gombok ===================== -->
    <!-- MaterialComponents/Material3 témában a sima <Button> tag futásidőben MaterialButton-ra
         cserélődik, ezért a stílusnak MaterialButton natív (app:) attribútumait kell
         használnia (nem közvetlen android:background-ot), hogy biztosan érvényesüljön. -->
    <style name="Widget.Glass.Button" parent="Widget.Material3.Button.OutlinedButton">
        <item name="strokeColor">@color/border</item>
        <item name="cornerRadius">10dp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="Widget.Glass.Button.Primary" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/primary</item>
        <item name="cornerRadius">10dp</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="Widget.Glass.Button.Link" parent="Widget.Material3.Button.TextButton">
        <item name="android:textColor">@color/primary</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="Widget.Glass.Button.Danger" parent="Widget.Glass.Button.Link">
        <item name="android:textColor">@color/danger</item>
    </style>

    <!-- ===================== Beviteli mezők ===================== -->
    <!-- Sima <EditText> AppCompatEditText-re cserélődik, ami elfogadja a közvetlen
         android:background-ot - itt biztonságos ezt az utat használni. M3 "outlined
         text field" jellegű, sík háttér, lekerekített kontúr. -->
    <style name="Widget.Glass.EditText" parent="android:Widget.Material.EditText">
        <item name="android:background">@drawable/bg_m3_input</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textColorHint">@color/text_muted</item>
    </style>

</resources>
