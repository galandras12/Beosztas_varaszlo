<Window x:Class="BeosztasVarazslo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Beosztás Varázsló"
        Width="1320" Height="840"
        MinWidth="1040" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackgroundBrush}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Navigációs sáv (a mögötte lévő Mica háttér áttetszőn átlátszik) -->
        <Border Grid.Column="0" Background="{DynamicResource NavPaneOverlayBrush}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="22,26,18,18">
                    <TextBlock Text="Beosztás" FontSize="18" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock Text="Varázsló" FontSize="18" FontWeight="SemiBold"
                               Foreground="{DynamicResource AccentBrush}" Margin="0,-4,0,0" />
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" Margin="10,0,10,16">
                    <Button x:Name="BtnExportDb" Content="Adatbázis mentése…" Style="{StaticResource LinkButton}"
                            HorizontalContentAlignment="Left" Click="BtnExportDb_Click" Margin="4,2" />
                    <Button x:Name="BtnImportDb" Content="Adatbázis betöltése…" Style="{StaticResource LinkButton}"
                            HorizontalContentAlignment="Left" Click="BtnImportDb_Click" Margin="4,2" />
                    <Button x:Name="BtnResetDb" Content="Alaphelyzet" Style="{StaticResource LinkButton}"
                            Foreground="{DynamicResource DangerBrush}"
                            HorizontalContentAlignment="Left" Click="BtnResetDb_Click" Margin="4,2" />
                </StackPanel>

                <ListBox x:Name="NavList" Style="{StaticResource NavListStyle}"
                         ItemContainerStyle="{StaticResource NavItemStyle}"
                         SelectionChanged="NavList_SelectionChanged">
                    <ListBoxItem Tag="settings">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE713;" FontFamily="{StaticResource IconFont}" Margin="0,0,12,0" />
                            <TextBlock Text="Beállítások" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="groups">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE716;" FontFamily="{StaticResource IconFont}" Margin="0,0,12,0" />
                            <TextBlock Text="Munkacsoportok" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="employees">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE77B;" FontFamily="{StaticResource IconFont}" Margin="0,0,12,0" />
                            <TextBlock Text="Dolgozók" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="schedule">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE787;" FontFamily="{StaticResource IconFont}" Margin="0,0,12,0" />
                            <TextBlock Text="Beosztás" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="print">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE749;" FontFamily="{StaticResource IconFont}" Margin="0,0,12,0" />
                            <TextBlock Text="Nyomtatás / Export" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListBoxItem>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Tartalom -->
        <Border Grid.Column="1" Background="{DynamicResource WindowBackgroundBrush}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="28,24">
                <ContentControl x:Name="PageHost" />
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
