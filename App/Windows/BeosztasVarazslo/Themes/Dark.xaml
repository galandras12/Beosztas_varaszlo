<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Klasszikus Windows Phone/Windows 8 "Metro" sötét téma: tömör fekete alap,
         vivid kobalt-kék accent szín, éles kontrasztok. -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#000000" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#0A0A0A" />
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="#1A1A1A" />
    <SolidColorBrush x:Key="BorderBrush" Color="#333333" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#A6A6A6" />
    <SolidColorBrush x:Key="AccentBrush" Color="#1BA1E2" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#3DB4EC" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#1580B3" />
    <SolidColorBrush x:Key="AccentSubtleBrush" Color="#122733" />
    <SolidColorBrush x:Key="DangerBrush" Color="#E51400" />
    <SolidColorBrush x:Key="DangerSubtleBrush" Color="#2E1210" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#60A917" />
    <SolidColorBrush x:Key="SuccessSubtleBrush" Color="#1C2A0C" />
    <SolidColorBrush x:Key="WarningBrush" Color="#E3A21A" />
    <SolidColorBrush x:Key="WarningSubtleBrush" Color="#332812" />
    <SolidColorBrush x:Key="NavBackgroundBrush" Color="#000000" />
    <SolidColorBrush x:Key="NavPaneOverlayBrush" Color="#000000" />
    <SolidColorBrush x:Key="WeekendBrush" Color="#2A2A2A" />
    <SolidColorBrush x:Key="HolidayBrush" Color="#442726" />
    <SolidColorBrush x:Key="VacationBrush" Color="#243324" />
    <SolidColorBrush x:Key="SickBrush" Color="#442726" />
    <SolidColorBrush x:Key="AbsenceBrush" Color="#332C24" />
    <SolidColorBrush x:Key="RestBrush" Color="#282E33" />

</ResourceDictionary>
