<Window x:Class="BeosztasVarazslo.Views.CellPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kódjelzés kiválasztása"
        Width="300" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <StackPanel Margin="18">
        <TextBlock x:Name="TxtHeader" Style="{StaticResource SectionTitle}" Margin="0,0,0,10" />
        <StackPanel x:Name="OptionsPanel" />
        <Button Content="Mégse" Margin="0,12,0,0" Click="BtnCancel_Click" />
    </StackPanel>
</Window>
