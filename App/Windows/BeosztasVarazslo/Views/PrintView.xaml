<UserControl x:Class="BeosztasVarazslo.Views.PrintView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel MaxWidth="700" HorizontalAlignment="Left">
        <TextBlock Text="Nyomtatás / Export" Style="{StaticResource PageTitle}" />

        <Border Style="{StaticResource CardBorder}">
            <StackPanel>
                <TextBlock Style="{StaticResource HintText}"
                           Text="A4 fekvő elrendezésű táblázat: munkakör szerint ABC sorrendben a dolgozók, a végén a következő hónapra átvitt órákkal. A PDF több oldalra is törik, ha sok a dolgozó; a JPG egyetlen, folytonos képként készül." />

                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <TextBlock Text="Év" VerticalAlignment="Center" Margin="0,0,8,0"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                    <TextBox x:Name="TxtYear" Width="100" Margin="0,0,16,0" LostFocus="Selection_Changed" />
                    <ComboBox x:Name="CmbMonth" Width="160" SelectionChanged="Selection_Changed" Foreground="Black"/>
                </StackPanel>

                <TextBlock x:Name="TxtSummary" Margin="0,10,0,0" Foreground="{DynamicResource TextPrimaryBrush}" />

                <StackPanel Margin="0,16,0,0">
                    <Button Content="Mentés PDF-ként (A4 fekvő, több oldalas)" Style="{StaticResource AccentButton}"
                            Margin="0,0,0,8" Click="BtnExportPdf_Click" />
                    <Button Content="Mentés JPG-ként" Margin="0,0,0,8" Click="BtnExportJpg_Click" />
                    <Button x:Name="BtnOpenFolder" Content="Exportok mappájának megnyitása" Click="BtnOpenFolder_Click" />
                </StackPanel>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
