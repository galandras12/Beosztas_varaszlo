<Window x:Class="BeosztasVarazslo.Views.EmployeeEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dolgozó"
        Width="460" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <StackPanel Margin="22">
        <TextBlock Text="Név" Style="{StaticResource HintText}" Margin="0,0,0,4" />
        <TextBox x:Name="TxtName" Margin="0,0,0,14" />

        <TextBlock Text="Munkacsoport" Style="{StaticResource HintText}" Margin="0,0,0,4" />
        <ComboBox x:Name="CmbGroup" Margin="0,0,0,14" DisplayMemberPath="Name" />

        <TextBlock Text="Munkaidő-arány (1 = teljes, 0.5 = fél)" Style="{StaticResource HintText}" Margin="0,0,0,4" />
        <TextBox x:Name="TxtFactor" Margin="0,0,0,14" />

        <TextBlock Style="{StaticResource HintText}" Margin="0,0,0,4">
            <Run Text="Max. kiadható szabadság (nap/év) — " />
            <Run Text="kötelező" Foreground="{DynamicResource DangerBrush}" />
        </TextBlock>
        <TextBox x:Name="TxtMaxVacation" Margin="0,0,0,14" />

        <TextBlock Text="Megjegyzés" Style="{StaticResource HintText}" Margin="0,0,0,4" />
        <TextBox x:Name="TxtNotes" AcceptsReturn="True" TextWrapping="Wrap" Height="60" Margin="0,0,0,4" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Mégse" Click="BtnCancel_Click" Margin="0,0,8,0" />
            <Button Content="Mentés" Style="{StaticResource AccentButton}" Click="BtnSave_Click" />
        </StackPanel>
    </StackPanel>
</Window>
