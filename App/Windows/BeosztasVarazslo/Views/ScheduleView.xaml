<UserControl x:Class="BeosztasVarazslo.Views.ScheduleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel HorizontalAlignment="Left">
        <TextBlock Text="Beosztás" Style="{StaticResource PageTitle}" />

        <Border Style="{StaticResource CardBorder}" MaxWidth="900" HorizontalAlignment="Left">
            <StackPanel>
                <TextBlock Text="Hónap kiválasztása" Style="{StaticResource SectionTitle}" />
                <StackPanel Orientation="Horizontal" Margin="0,6,0,10">
                    <TextBlock Text="Év" VerticalAlignment="Center" Margin="0,0,8,0"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                    <TextBox x:Name="TxtYear" Width="100" Margin="0,0,16,0" LostFocus="TxtYear_LostFocus" />
                    <Button x:Name="BtnCopyPrevCarry" Content="Előző havi maradvány másolása bejövő óraként"
                            Click="BtnCopyPrevCarry_Click" />
                </StackPanel>
                <UniformGrid Columns="4" Rows="3">
                    <Button x:Name="BtnMonth1" Content="Jan" Style="{StaticResource LinkButton}" Click="MonthButton_Click" />
                    <Button x:Name="BtnMonth2" Content="Feb" Style="{StaticResource LinkButton}" Click="MonthButton_Click" />
                    <Button x:Name="BtnMonth3" Content="Már" Style="{StaticResource LinkButton}" Click="MonthButton_Click" />
                    <Button x:Name="BtnMonth4" Content="Ápr" Style="{StaticResource LinkButton}" Click="MonthButton_Click" />
                    <Button x:Name="BtnMonth5" Content="Máj" Style="{StaticResource LinkButton}" Click="MonthButton_Click" />
                    <Button x:Name="BtnMonth6" Content="Jún" Style="{StaticResource LinkButton}" Click="MonthButton_Click" />
                    <Button x:Name="BtnMonth7" Content="Júl" Style="{StaticResource LinkButton}" Click="MonthButton_Click" />
                    <Button x:Name="BtnMonth8" Content="Aug" Style="{StaticResource LinkButton}" Click="MonthButton_Click" />
                    <Button x:Name="BtnMonth9" Content="Sze" Style="{StaticResource LinkButton}" Click="MonthButton_Click" />
                    <Button x:Name="BtnMonth10" Content="Okt" Style="{StaticResource LinkButton}" Click="MonthButton_Click" />
                    <Button x:Name="BtnMonth11" Content="Nov" Style="{StaticResource LinkButton}" Click="MonthButton_Click" />
                    <Button x:Name="BtnMonth12" Content="Dec" Style="{StaticResource LinkButton}" Click="MonthButton_Click" />
                </UniformGrid>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource CardBorder}">
            <StackPanel>
                <TextBlock x:Name="TxtScheduleTitle" Style="{StaticResource SectionTitle}" />
                <TextBlock Style="{StaticResource HintText}"
                           Text="Kattints egy napra a kódjelzés kiválasztásához. Irodai csoportnál hétvégén/ünnepnapon nincs munkavégzés." />
                <StackPanel Orientation="Horizontal">
                    <StackPanel x:Name="NamesColumn" />
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="DaysColumn" />
                    </ScrollViewer>
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource CardBorder}">
            <StackPanel>
                <TextBlock Text="Műszak-lefedettség" Style="{StaticResource SectionTitle}" />
                <TextBlock Style="{StaticResource HintText}"
                           Text="Azon munkacsoportoknál, ahol meg van adva, hány dolgozónak kell egy műszakban együtt dolgoznia." />
                <StackPanel x:Name="CoveragePanel" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
