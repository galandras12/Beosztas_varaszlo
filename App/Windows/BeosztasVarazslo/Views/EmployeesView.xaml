<UserControl x:Class="BeosztasVarazslo.Views.EmployeesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel MaxWidth="1000" HorizontalAlignment="Left">
        <Grid Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Dolgozók" Style="{StaticResource PageTitle}" Margin="0" Grid.Column="0" />
            <Button Grid.Column="1" Content="+ Új dolgozó" Style="{StaticResource AccentButton}"
                    VerticalAlignment="Center" Click="BtnAddEmployee_Click" />
        </Grid>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
            <TextBlock Text="Szabadság-nyilvántartás éve" VerticalAlignment="Center" Margin="0,0,8,0"
                       Foreground="{DynamicResource TextSecondaryBrush}" />
            <TextBox x:Name="TxtVacationYear" Width="100" TextChanged="TxtVacationYear_TextChanged" />
        </StackPanel>

        <StackPanel x:Name="EmployeesPanel" />
    </StackPanel>
</UserControl>
