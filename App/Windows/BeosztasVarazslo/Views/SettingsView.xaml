<UserControl x:Class="BeosztasVarazslo.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel MaxWidth="900" HorizontalAlignment="Left">
        <TextBlock Text="Beállítások" Style="{StaticResource PageTitle}" />

        <Border Style="{StaticResource CardBorder}">
            <StackPanel>
                <TextBlock Text="Havi kötelező óraszám és munkanapok" Style="{StaticResource SectionTitle}" />
                <TextBlock Style="{StaticResource HintText}"
                           Text="Egy teljes munkaidős dolgozó havi kötelező óraszáma. A munkaidő-arány (pl. részmunkaidő) és a kivett szabadság/hiányzás ezt módosítja." />
                <StackPanel x:Name="MonthHoursPanel" />
                <Button Content="Alapértékek visszaállítása" HorizontalAlignment="Left" Margin="0,10,0,0"
                        Click="BtnResetMonthHours_Click" />
            </StackPanel>
        </Border>

        <Border Style="{StaticResource CardBorder}">
            <StackPanel>
                <TextBlock Text="Munkaszüneti napok" Style="{StaticResource SectionTitle}" />
                <TextBlock Style="{StaticResource HintText}"
                           Text="A magyar munkaszüneti napok automatikusan számolódnak. Egyéni ünnepnap felvehető, vagy egy automatikus kikapcsolható." />

                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBlock Text="Év" VerticalAlignment="Center" Margin="0,0,8,0"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                    <TextBox x:Name="TxtHolidayYear" Width="100" TextChanged="TxtHolidayYear_TextChanged" />
                </StackPanel>

                <StackPanel x:Name="HolidayListPanel" />

                <StackPanel Orientation="Horizontal" Margin="0,12,0,0" VerticalAlignment="Center">
                    <DatePicker x:Name="DpNewHolidayDate" Width="140" />
                    <TextBlock Text="Név:" VerticalAlignment="Center" Margin="10,0,6,0"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                    <TextBox x:Name="TxtNewHolidayName" Width="220" />
                    <Button Content="Hozzáadás" Style="{StaticResource AccentButton}" Margin="8,0,0,0" Click="BtnAddHoliday_Click" />
                </StackPanel>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
